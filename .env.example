# Public Monad mainnet deployments (single-line JSON from the Foundry scripts).
# Missing configuration leaves the affected product read-only. Chain ID is 143.
# See docs/LIVE-DEPLOYMENT.md for the manifest fields.
SETSUNA_MAINNET_EARN=
SETSUNA_MAINNET_TRADING=

# Keeper host only. Never place private keys in Vercel or NEXT_PUBLIC_ variables.
MONAD_RPC_URL=https://rpc.monad.xyz
SETSUNA_MAINNET_MON_KEEPER_PRIVATE_KEY=
SETSUNA_MAINNET_USDC_KEEPER_PRIVATE_KEY=
# Persistent journals; use a dedicated signer for each vault.
SETSUNA_KEEPER_STATE_DIR=/data/setsuna-mainnet-keepers
