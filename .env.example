# No environment variables are required for public, read-only Monad markets.
# Remote trading is for test funds on a dedicated Monad fork only.
# Keep the upstream RPC on the server. The browser receives /api/rpc/.
SETSUNA_DEMO_RPC_URL=
# Single-line JSON generated from a deployed fork; see docs/LIVE-DEPLOYMENT.md.
SETSUNA_DEMO_MANIFEST=
# Optional private administrator endpoint for the fixed demo faucet call only.
# Requires a funded SetsunaDemoFaucet on chain 31337 and its address in the manifest.
# Never prefix this variable with NEXT_PUBLIC_.
SETSUNA_DEMO_ADMIN_RPC_URL=

# Worker host only; do not add executor keys to the Vercel/browser environment.
# Generated by scripts/prepare-demo-workers.mjs after a unified deployment.
SETSUNA_MON_KEEPER_PRIVATE_KEY=
SETSUNA_USDC_KEEPER_PRIVATE_KEY=
# Mount a persistent worker volume here.
SETSUNA_WORKER_STATE_DIR=/data/setsuna
