{
  "name": "setsuna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:browser": "node scripts/check-setsuna.mjs",
    "contracts:build": "forge build --root contracts --skip test --skip script && node scripts/export-abis.mjs",
    "contracts:test": "forge test --root contracts",
    "contracts:test:fork": "RUN_FORK=true forge test --root contracts --match-test testFork -vv",
    "contracts:test:earn": "RUN_FORK=true forge test --root contracts --match-contract 'SetsunaEarn(Test|ForkTest)' -vv",
    "keeper": "node scripts/keeper.mjs",
    "earn:keeper": "node scripts/earn-keeper.mjs",
    "earn:keeper:watch": "node scripts/earn-keeper-watch.mjs",
    "demo:local": "npm run contracts:build && node scripts/local-demo.mjs",
    "test:keeper": "node --test scripts/keeper-core.test.mjs",
    "test:earn-keeper": "node --test scripts/earn-keeper-core.test.mjs",
    "setup:contracts": "node scripts/setup-contracts.mjs",
    "dev:demo": "SETSUNA_LOCAL_DEMO=1 next dev --hostname 127.0.0.1",
    "earn:demo": "npm run contracts:build && node scripts/earn-local-demo.mjs --keep",
    "dev:earn": "SETSUNA_DIST_DIR=.next-earn SETSUNA_LOCAL_EARN=1 next dev --hostname 127.0.0.1 --port 3007",
    "contracts:test:mon": "RUN_FORK=true forge test --root contracts --match-contract 'SetsunaMON(Test|ForkTest)' -vv",
    "check:setsmon": "node scripts/check-setsmon.mjs",
    "trading:demo": "npm run contracts:build && node scripts/earn-local-demo.mjs --trading --keep",
    "dev:trading": "SETSUNA_DIST_DIR=.next-trading SETSUNA_LOCAL_TRADING=1 next dev --hostname 127.0.0.1 --port 3008",
    "contracts:test:trading": "RUN_FORK=true forge test --root contracts --match-contract 'Setsuna(Spot|Trading).*Test' -vv",
    "check:trading": "node scripts/check-trading.mjs && node scripts/check-trading-recovery.mjs",
    "check:journey": "node scripts/check-hosted-journey.mjs",
    "demo:verified": "node scripts/check-hosted-journey.mjs --keep-demo",
    "check:unified": "node scripts/check-hosted-journey.mjs --unified",
    "demo:unified": "node scripts/check-hosted-journey.mjs --unified --keep-demo",
    "demo:trading-watch": "node scripts/demo-trading-watch.mjs",
    "test:trading-receipts": "node --test scripts/trading-receipt.test.mjs",
    "test:markets": "node --test scripts/market-view.test.mjs scripts/live-market.test.mjs scripts/demo-config.test.mjs",
    "test:demo-faucet": "node --test scripts/demo-faucet.test.mjs",
    "demo:workers:check": "node scripts/start-demo-workers.mjs",
    "demo:workers": "node scripts/start-demo-workers.mjs --execute",
    "usdc:demo": "npm run contracts:build && node scripts/usdc-v2-demo.mjs",
    "dev:usdc": "SETSUNA_DIST_DIR=.next-usdc SETSUNA_LOCAL_USDC=1 next dev --hostname 127.0.0.1 --port 3014",
    "contracts:test:usdc-v2": "RUN_FORK=true forge test --root contracts --match-contract 'SetsunaUSDCV2(Test|ForkTest)' -vv",
    "check:usdc-v2": "node scripts/check-usdc-v2.mjs",
    "usdc:demo:five": "npm run contracts:build && node scripts/usdc-v2-demo.mjs --curvance",
    "dev:usdc-five": "SETSUNA_DIST_DIR=.next-usdc-five SETSUNA_LOCAL_USDC=5 next dev --hostname 127.0.0.1 --port 3015",
    "check:usdc-five": "node scripts/check-usdc-v2.mjs --curvance",
    "contracts:test:usdc-five": "RUN_FORK=true forge test --root contracts --match-contract '(CurvanceUSDCAdapterTest|SetsunaUSDCFiveForkTest|SetsunaUSDCV2Test)' -vv",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "marked": "18.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "1.2.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
