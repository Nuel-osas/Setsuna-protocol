{
  "name": "setsuna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "contracts:build": "forge build --root contracts --skip test --skip script && node scripts/export-abis.mjs",
    "contracts:test": "forge test --root contracts",
    "contracts:test:earn": "forge test --root contracts --match-contract '^SetsunaEarn(Test|FeeTest)$' -vv",
    "keeper": "node scripts/keeper.mjs",
    "earn:keeper": "node scripts/earn-keeper.mjs",
    "earn:keeper:watch": "node scripts/earn-keeper-watch.mjs",
    "test:keeper": "node --test scripts/keeper-core.test.mjs",
    "test:earn-keeper": "node --test scripts/earn-keeper-core.test.mjs",
    "setup:contracts": "node scripts/setup-contracts.mjs",
    "contracts:test:mon": "forge test --root contracts --match-contract '^SetsunaMONTest$' -vv",
    "contracts:test:trading": "forge test --root contracts --match-contract '^(Setsuna(Account|Spot|SpotFee|PerpsFee)Test|PerplRiskTest)$' -vv",
    "test:trading-receipts": "node --test scripts/trading-receipt.test.mjs",
    "contracts:test:usdc-v2": "forge test --root contracts --match-contract '^SetsunaUSDCV2Test$' -vv",
    "check:docs": "node scripts/check-docs.mjs",
    "test:portfolio": "node --test scripts/portfolio-math.test.mjs",
    "test:order-types": "node --test scripts/order-types.test.mjs",
    "test:markets": "node --test scripts/market-view.test.mjs scripts/live-market.test.mjs",
    "test:mainnet": "node --test scripts/mainnet-deployment.test.mjs"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "lightweight-charts": "^5.2.1",
    "marked": "18.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "1.2.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
